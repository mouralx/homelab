FROM python:3.12-slim

EXPOSE 8000

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV UV_LINK_MODE=copy
ENV PATH="/root/.local/bin:$PATH"
ENV HOST="0.0.0.0"
ENV PORT="8000"
ENV AUTH_USE_AUTH="false"
ENV OPENAI_API_BASE_URL=""
ENV OPENAI_BASE_URL=""

# Install build deps, system tools, and uv at build time
RUN apt-get update -yq && \
    apt-get install -yq --no-install-recommends build-essential curl git libpq-dev postgresql-client && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir uv

# Clone Honcho at a pinned release
RUN git clone https://github.com/plastic-labs/honcho.git /honcho && \
    cd /honcho && \
    git checkout v3.0.11 && \
    uv sync

COPY infra/scripts/honcho.entrypoint.sh /honcho.entrypoint.sh

WORKDIR /honcho

ENTRYPOINT ["sh", "/honcho.entrypoint.sh"]
