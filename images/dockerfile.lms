FROM ubuntu:latest

WORKDIR /lms

# Required on every container creation, even when the LM Studio data is persisted.
RUN apt-get update -yq && \
    apt-get install -yq --no-install-recommends curl ca-certificates libatomic1 libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:$PATH"

ENV LLM_MODEL="qwen/qwen3.5-4b"

ENV EMBEDDING_MODEL="text-embedding-nomic-embed-text-v1.5"

EXPOSE 4321

COPY scripts/image.entrypoint.lmstudio.sh lmstudio.entrypoint.sh

RUN chmod +x lmstudio.entrypoint.sh

ENTRYPOINT [ "sh", "lmstudio.entrypoint.sh" ]
