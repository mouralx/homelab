# LOCAL SETUP REFERENCE ONLY
# GitHub deployment reads GitHub variables/secrets, never this file or a local .env.
# All assignments below are intentionally empty. Commented examples are samples,
# not active values. Fill every non-secret setting and the required credentials.
#
# 1. From the repository root: cp -n .env.example .env
# 2. Restrict access: chmod 600 .env
# 3. Copy each suitable commented sample to its assignment in .env, replace
#    example.com domains with your own, and fill the credentials. Never commit .env.
# 4. Generate each NEW password/token independently: openssl rand -hex 32
#    Tempo passwords must have at least 16 letters, digits, underscores or hyphens.
#    Existing installations must reuse their actual credentials. Editing .env
#    does not rotate existing database passwords or the Keycloak admin password.
# 5. Complete host storage, registry login, Gitea registration, DNS/HTTPS proxying
#    and OpenClaw onboarding as described in readme.md and docs/operations.md.
# 6. Validate without printing secrets: docker compose --env-file .env config --quiet
# 7. Follow docs/tempo.md for the database login checks and migration BEFORE up -d.
#    A plain docker compose up does not apply Tempo schema migrations.
#
# Values describe service ENVIRONMENT settings. Ports, IPs, host mount paths and
# most image versions stay in services/compose.yaml. Container paths, database
# roles and internal URLs must remain aligned with those mounts and init scripts.
# Compose has no fallback values. Include optional blank credentials as KEY=.
# Compose loads .env itself; do not blindly source this file as a shell script.
# Quotes are needed for spaces or literal special characters; never paste secrets
# into commands, logs, screenshots or the example file.

# --- Local Compose and host ---

# Compose file, relative to the repository root.
# Example: COMPOSE_FILE=services/compose.yaml
COMPOSE_FILE=

# Host account running rootless Docker. Find it with: id -u.
# Example: USER_ID=1000
USER_ID=

# IANA timezone shared by the services.
# Example: TIME_ZONE=Europe/Lisbon
TIME_ZONE=

# --- Published image tags ---

# Use a tag published for BOTH the Tempo API and portal; stable follows releases.
# Example: TEMPO_TAG=stable
TEMPO_TAG=

# Runner image tag; the repository is defined in Compose.
# Example: GITEA_RUNNER_TAG=2
GITEA_RUNNER_TAG=

# Published Digger image tag.
# Example: DIGGER_TAG=stable
DIGGER_TAG=

# --- Tempo database credentials and identity ---

# REQUIRED: independent PostgreSQL administrator password.
# No shared sample secret: generate one or obtain the required existing value.
TEMPO_POSTGRES_PASSWORD=

# REQUIRED: password for the tempo database role.
# No shared sample secret: generate one or obtain the required existing value.
TEMPO_APP_DB_PASSWORD=

# REQUIRED: password for the keycloak database role.
# No shared sample secret: generate one or obtain the required existing value.
TEMPO_IDENTITY_DB_PASSWORD=

# REQUIRED: initial Keycloak administrator password.
# No shared sample secret: generate one or obtain the required existing value.
TEMPO_KEYCLOAK_ADMIN_PASSWORD=

# Initial Keycloak administrator login name.
# Example: TEMPO_KEYCLOAK_ADMIN=admin
TEMPO_KEYCLOAK_ADMIN=

# Browser-facing HTTPS portal URL; configure DNS/TLS and proxy to port 8080.
# Example: TEMPO_PORTAL_URL=https://tempo.example.com
TEMPO_PORTAL_URL=

# Browser-facing HTTPS Keycloak URL; configure DNS/TLS and proxy to port 8081.
# Example: TEMPO_IDENTITY_URL=https://identity.example.com
TEMPO_IDENTITY_URL=

# Tempo API runtime environment.
# Example: ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=

# API container listener; must match the Compose container port.
# Example: TEMPO_API_ASPNETCORE_URLS=http://+:8080
TEMPO_API_ASPNETCORE_URLS=

# OIDC token audience; must match the imported realm client.
# Example: TEMPO_API_AUTH__AUDIENCE=tempo-api
TEMPO_API_AUTH__AUDIENCE=

# Keycloak backchannel address INSIDE the Docker network.
# Example: TEMPO_API_AUTH__INTERNALBASEURL=http://tempo-keycloak:8080
TEMPO_API_AUTH__INTERNALBASEURL=

# --- PostgreSQL and Keycloak internals ---

# PostgreSQL bootstrap administrator, passed as POSTGRES_USER.
# Example: POSTGRES_POSTGRES_USER=postgres
POSTGRES_POSTGRES_USER=

# Bootstrap database, passed as POSTGRES_DB.
# Example: POSTGRES_POSTGRES_DB=postgres
POSTGRES_POSTGRES_DB=

# Keycloak database provider.
# Example: KEYCLOAK_KC_DB=postgres
KEYCLOAK_KC_DB=

# JDBC URL using the internal PostgreSQL alias and port.
# Example: KEYCLOAK_KC_DB_URL=jdbc:postgresql://tempo-postgres:5432/keycloak
KEYCLOAK_KC_DB_URL=

# Database role created by services/tempo/init.sh.
# Example: KEYCLOAK_KC_DB_USERNAME=keycloak
KEYCLOAK_KC_DB_USERNAME=

# Enable internal HTTP behind the HTTPS reverse proxy.
# Example: KEYCLOAK_KC_HTTP_ENABLED=true
KEYCLOAK_KC_HTTP_ENABLED=

# Enable Keycloak metrics; restrict access at the proxy.
# Example: KEYCLOAK_KC_METRICS_ENABLED=true
KEYCLOAK_KC_METRICS_ENABLED=

# Forwarded-header format supplied by Nginx Proxy Manager.
# Example: KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_PROXY_HEADERS=

# Trust only the NPM container IP from Compose.
# Example: KEYCLOAK_PROXY_TRUSTED_ADDRESSES=10.203.0.12/32
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=

# --- Gitea and its Actions runner ---

# Gitea image user UID; ensure the persisted directories have matching ownership.
# Example: GITEA_UID=1000
GITEA_UID=

# Gitea image user GID.
# Example: GITEA_GID=1000
GITEA_GID=

# Runner registration URL reachable from the Docker network.
# Example: GITEA_INSTANCE_URL=http://gitea:3000
GITEA_INSTANCE_URL=

# Runner display name in Gitea.
# Example: GITEA_RUNNER_NAME=beelink
GITEA_RUNNER_NAME=

# Container path of the configuration file mounted by Compose.
# Example: GITEA_RUNNER_CONFIG_FILE=/config.yaml
GITEA_RUNNER_CONFIG_FILE=

# Comma-separated labels and job images; keep compatible with your workflows.
# Example: GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:22-bookworm,homelab:docker://node:22-bookworm
GITEA_RUNNER_LABELS=

# REQUIRED for first registration: create a runner token in Gitea Actions settings.
# No shared sample secret: generate one or obtain the required existing value.
GITEA_RUNNER_REGISTRATION_TOKEN=

# --- Media identity ---

# LinuxServer media UID. Keep 0 with the documented rootless Docker setup.
# Example: MEDIA_UID=0
MEDIA_UID=

# LinuxServer media GID. Keep 0 with the documented rootless Docker setup.
# Example: MEDIA_GID=0
MEDIA_GID=

# Media file creation mask; preserve the leading zeros.
# Example: MEDIA_UMASK=002
MEDIA_UMASK=

# --- Transmission RPC credentials used by Digger ---

# RPC username. This does NOT configure Transmission server authentication.
# Example: TRANSMISSION_USERNAME=transmission
TRANSMISSION_USERNAME=

# RPC password: must match the existing Transmission server configuration.
# No shared sample secret: generate one or obtain the required existing value.
TRANSMISSION_PASSWORD=

# Digger RPC username. For local Compose, copy the Transmission username or use this reference.
# Example: DIGGER_TRANSMISSION_USERNAME=${TRANSMISSION_USERNAME}
DIGGER_TRANSMISSION_USERNAME=

# Digger RPC password. For local Compose, copy the matching password or use this reference.
# Example: DIGGER_TRANSMISSION_PASSWORD=${TRANSMISSION_PASSWORD}
DIGGER_TRANSMISSION_PASSWORD=

# --- Digger ---

# Digger .NET runtime environment.
# Example: DIGGER_ENVIRONMENT=Production
DIGGER_ENVIRONMENT=

# SQLite connection string; this is a CONTAINER path. Keep quotes for the space.
# Example: DIGGER_DATABASE_URL="Data Source=/data/digger.db"
DIGGER_DATABASE_URL=

# Container movie path shared with Transmission; keep aligned with the Compose mounts.
# Example: DIGGER_MOVIES_DIR=/downloads/complete/movies
DIGGER_MOVIES_DIR=

# RPC endpoint on the internal Docker network.
# Example: DIGGER_TRANSMISSION_RPC_URL=http://transmission:9091/transmission/rpc
DIGGER_TRANSMISSION_RPC_URL=

# Movie library budget in GiB; choose a size appropriate for your SSD.
# Example: DIGGER_MAX_LIBRARY_SIZE_GB=750
DIGGER_MAX_LIBRARY_SIZE_GB=

# Minimum free-space reserve in MiB; 51200 is 50 GiB.
# Example: DIGGER_DISK_RESERVE_MB=51200
DIGGER_DISK_RESERVE_MB=

# Discovery URL: retain the literal {0} pagination placeholder. Keep the URL quoted.
# Example: DIGGER_YTS_API_URL="https://movies-api.accel.li/api/v2/list_movies.json?quality=2160p&sort_by=year,rating,date_added&order_by=desc&limit=50&page={0}"
DIGGER_YTS_API_URL=

# --- n8n ---

# Public hostname ONLY, without a scheme or path.
# Example: N8N_HOST=n8n.example.com
N8N_HOST=

# Public protocol used behind the HTTPS proxy.
# Example: N8N_PROTOCOL=https
N8N_PROTOCOL=

# Full public webhook base URL, matching your proxy route.
# Example: N8N_WEBHOOK_URL=https://n8n.example.com/webhook
N8N_WEBHOOK_URL=

# Node.js runtime environment.
# Example: N8N_NODE_ENV=production
N8N_NODE_ENV=

# Enforce restrictive permissions for n8n settings.
# Example: N8N_N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=

# Allowed file-access directory INSIDE the container.
# Example: N8N_N8N_RESTRICT_FILE_ACCESS_TO=/files
N8N_N8N_RESTRICT_FILE_ACCESS_TO=

# --- OpenClaw ---

# Container home directory; keep aligned with its mounted configuration.
# Example: OPENCLAW_HOME=/home/node
OPENCLAW_HOME=

# REQUIRED for first LAN-bound startup: generate a unique token. Provider onboarding is separate.
# No shared sample secret: generate one or obtain the required existing value.
OPENCLAW_GATEWAY_TOKEN=

# --- Portainer ---

# Enable management of externally created stacks.
# Example: PORTAINER_MANAGE_EXTERNAL_STACKS=1
PORTAINER_MANAGE_EXTERNAL_STACKS=

# --- Vault ---

# Public HTTPS Vault URL; configure DNS/TLS and proxy routing separately.
# Example: VAULT_API_ADDR=https://vault.example.com
VAULT_API_ADDR=

# Vault CLI address INSIDE its own container.
# Example: VAULT_VAULT_ADDR=http://127.0.0.1:8200
VAULT_VAULT_ADDR=

# Skip setcap in the container; the Raft configuration disables mlock.
# Example: VAULT_SKIP_SETCAP=true
VAULT_SKIP_SETCAP=
